{
    "name": "cc-format",
    "displayName": "%displayName%",
    "description": "%description%",
    "version": "2.0.0",
    "publisher": "wysaid",
    "license": "MIT",
    "icon": "logo.png",
    "engines": {
        "vscode": "^1.50.0",
        "node": ">=18"
    },
    "categories": [
        "Formatters",
        "Programming Languages"
    ],
    "keywords": [
        "cmake",
        "CMakeLists.txt",
        "shell",
        "shellscript",
        "bash",
        "shfmt",
        "formatter",
        "formatting",
        "beautify",
        "cc-format",
        "indent",
        "indentation",
        "code-style",
        "cmake format",
        "cmake formatter",
        "shell-format",
        "zero dependencies",
        "code quality",
        "auto-format"
    ],
    "activationEvents": [
        "onLanguage:cmake",
        "onLanguage:shellscript",
        "onCustomEditor:ccFormat.configEditor"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "cmake",
                "extensions": [
                    ".cmake"
                ],
                "filenames": [
                    "CMakeLists.txt"
                ]
            }
        ],
        "jsonValidation": [
            {
                "fileMatch": [
                    ".cc-format.jsonc",
                    ".cc-format"
                ],
                "url": "./resources/cc-format.schema.json"
            }
        ],
        "commands": [
            {
                "command": "cc-format.formatDocument",
                "title": "%command.formatDocument%"
            },
            {
                "command": "cc-format.createConfig",
                "title": "%command.createConfig%"
            },
            {
                "command": "cc-format.openVisualEditor",
                "title": "%command.openVisualEditor%"
            },
            {
                "command": "cc-format.openGlobalSettings",
                "title": "%command.openGlobalSettings%"
            },
            {
                "command": "cc-format.switchToTextEditor",
                "title": "%command.switchToTextEditor%"
            }
        ],
        "customEditors": [
            {
                "viewType": "ccFormat.configEditor",
                "displayName": "%customEditor.displayName%",
                "selector": [
                    {
                        "filenamePattern": "*.cc-format.jsonc"
                    },
                    {
                        "filenamePattern": ".cc-format.jsonc"
                    },
                    {
                        "filenamePattern": ".cc-format"
                    }
                ],
                "priority": "default"
            }
        ],
        "configuration": {
            "title": "%config.title%",
            "properties": {
                "ccFormat.cmake.useTabs": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.useTabs.description%",
                    "order": 1
                },
                "ccFormat.cmake.tabSize": {
                    "type": "number",
                    "default": 4,
                    "minimum": 1,
                    "maximum": 16,
                    "description": "%config.tabSize.description%",
                    "order": 2
                },
                "ccFormat.cmake.indentSize": {
                    "type": "number",
                    "default": 4,
                    "minimum": 1,
                    "maximum": 16,
                    "description": "%config.indentSize.description%",
                    "order": 3
                },
                "ccFormat.cmake.continuationIndentSize": {
                    "type": "number",
                    "default": 8,
                    "minimum": 1,
                    "maximum": 16,
                    "description": "%config.continuationIndentSize.description%",
                    "order": 4
                },
                "ccFormat.cmake.keepIndentOnEmptyLines": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.keepIndentOnEmptyLines.description%",
                    "order": 5
                },
                "ccFormat.cmake.spaceBeforeCommandDefinitionParentheses": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.spaceBeforeCommandDefinitionParentheses.description%",
                    "order": 10
                },
                "ccFormat.cmake.spaceBeforeCommandCallParentheses": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.spaceBeforeCommandCallParentheses.description%",
                    "order": 11
                },
                "ccFormat.cmake.spaceBeforeIfParentheses": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.spaceBeforeIfParentheses.description%",
                    "order": 12
                },
                "ccFormat.cmake.spaceBeforeForeachParentheses": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.spaceBeforeForeachParentheses.description%",
                    "order": 13
                },
                "ccFormat.cmake.spaceBeforeWhileParentheses": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.spaceBeforeWhileParentheses.description%",
                    "order": 14
                },
                "ccFormat.cmake.spaceInsideCommandDefinitionParentheses": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.spaceInsideCommandDefinitionParentheses.description%",
                    "order": 20
                },
                "ccFormat.cmake.spaceInsideCommandCallParentheses": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.spaceInsideCommandCallParentheses.description%",
                    "order": 21
                },
                "ccFormat.cmake.spaceInsideIfParentheses": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.spaceInsideIfParentheses.description%",
                    "order": 22
                },
                "ccFormat.cmake.spaceInsideForeachParentheses": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.spaceInsideForeachParentheses.description%",
                    "order": 23
                },
                "ccFormat.cmake.spaceInsideWhileParentheses": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.spaceInsideWhileParentheses.description%",
                    "order": 24
                },
                "ccFormat.cmake.maxBlankLines": {
                    "type": "number",
                    "default": 2,
                    "minimum": 0,
                    "maximum": 20,
                    "description": "%config.maxBlankLines.description%",
                    "order": 30
                },
                "ccFormat.cmake.maxTrailingBlankLines": {
                    "type": "number",
                    "default": 1,
                    "minimum": 0,
                    "description": "%config.maxTrailingBlankLines.description%",
                    "order": 31
                },
                "ccFormat.cmake.commandCase": {
                    "type": "string",
                    "default": "unchanged",
                    "enum": [
                        "unchanged",
                        "lowercase",
                        "uppercase"
                    ],
                    "enumDescriptions": [
                        "%config.commandCase.unchanged%",
                        "%config.commandCase.lowercase%",
                        "%config.commandCase.uppercase%"
                    ],
                    "description": "%config.commandCase.description%",
                    "order": 32
                },
                "ccFormat.cmake.lineLength": {
                    "type": "number",
                    "default": 0,
                    "minimum": 0,
                    "description": "%config.lineLength.description%",
                    "order": 40
                },
                "ccFormat.cmake.alignMultiLineArguments": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.alignMultiLineArguments.description%",
                    "order": 41
                },
                "ccFormat.cmake.alignMultiLineParentheses": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.alignMultiLineParentheses.description%",
                    "order": 42
                },
                "ccFormat.cmake.alignControlFlowParentheses": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.alignControlFlowParentheses.description%",
                    "order": 43
                },
                "ccFormat.cmake.enableProjectConfig": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.enableProjectConfig.description%",
                    "order": 50
                },
                "ccFormat.shell.shfmtPath": {
                    "type": "string",
                    "default": "",
                    "description": "%config.shell.shfmtPath.description%",
                    "order": 100
                },
                "ccFormat.shell.indent": {
                    "type": "number",
                    "default": 0,
                    "minimum": 0,
                    "maximum": 16,
                    "description": "%config.shell.indent.description%",
                    "order": 101
                },
                "ccFormat.shell.variant": {
                    "type": "string",
                    "default": "auto",
                    "enum": [
                        "auto",
                        "bash",
                        "posix",
                        "mksh",
                        "bats"
                    ],
                    "enumDescriptions": [
                        "%config.shell.variant.auto%",
                        "%config.shell.variant.bash%",
                        "%config.shell.variant.posix%",
                        "%config.shell.variant.mksh%",
                        "%config.shell.variant.bats%"
                    ],
                    "description": "%config.shell.variant.description%",
                    "order": 102
                },
                "ccFormat.shell.binaryNextLine": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.shell.binaryNextLine.description%",
                    "order": 103
                },
                "ccFormat.shell.caseIndent": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.shell.caseIndent.description%",
                    "order": 104
                },
                "ccFormat.shell.spaceRedirects": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.shell.spaceRedirects.description%",
                    "order": 105
                },
                "ccFormat.shell.keepPadding": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.shell.keepPadding.description%",
                    "order": 106
                },
                "ccFormat.shell.functionNextLine": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.shell.functionNextLine.description%",
                    "order": 107
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "pnpm run build",
        "build": "pnpm run type-check && webpack --mode production",
        "build:dev": "webpack --mode development",
        "watch": "webpack --mode development --watch",
        "clean": "rm -rf dist",
        "type-check": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/vscode": "^1.50.0",
        "ts-loader": "^9.5.1",
        "typescript": "^5.3.3",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/wysaid/cc-format",
        "directory": "packages/vscode"
    },
    "bugs": {
        "url": "https://github.com/wysaid/cc-format/issues"
    },
    "homepage": "https://github.com/wysaid/cc-format#readme",
    "dependencies": {
        "@cc-format/core": "workspace:*",
        "@cc-format/shell": "workspace:*"
    }
}
