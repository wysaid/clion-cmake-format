{
    "name": "@cc-format/cli",
    "version": "1.5.0",
    "description": "Professional code formatter for CMake and Shell scripts — Fast, zero-dependency command line tool",
    "main": "./dist/cli.js",
    "bin": {
        "cc-format": "./dist/cli.js"
    },
    "author": "wysaid",
